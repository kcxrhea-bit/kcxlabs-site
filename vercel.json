{
  "redirects": [
    {
      "source": "/kids",
      "destination": "/kids/",
      "permanent": false
    },
    {
      "source": "/nexus-cloud",
      "destination": "/nexus",
      "permanent": true
    },
    {
      "source": "/nexus-cloud/portal",
      "destination": "/nexus/portal",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/nexus/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/router?__kcx_path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/kids/(.*).wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/kids/index.service.worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/kids/index.manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
