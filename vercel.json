{
  "redirects": [
    {
      "source": "/nexus-cloud",
      "destination": "/nexus",
      "permanent": true
    },
    {
      "source": "/nexus-cloud/portal",
      "destination": "/nexus/portal",
      "permanent": true
    },
    {
      "source": "/resume-services",
      "destination": "/resume",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/nexus/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
