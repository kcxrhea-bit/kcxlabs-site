{
  "redirects": [
    {
      "source": "/snapcal",
      "destination": "/snapcal/",
      "permanent": false
    },
    {
      "source": "/nexus-cloud",
      "destination": "/nexus",
      "permanent": true
    },
    {
      "source": "/nexus-cloud/portal",
      "destination": "/nexus/portal",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/nexus/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/router?__kcx_path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
