# KCx Media Center — required environment variables (TEMPLATE ONLY)
#
# Copy to .env.local for local development and set the real values in the Vercel
# dashboard for production. .env.local is gitignored; this template is not, so
# it must never contain a real value.
#
# RULE: none of these may ever be prefixed VITE_. Vite inlines VITE_* into the
# public bundle, where any visitor can read it. Everything below is server-side
# only and is read by the API functions and the migration script.

# ─── Cloudflare R2 (object storage) ─────────────────────────────────────────
# From the Cloudflare dashboard: R2 → Manage API Tokens. Create an "Object Read
# & Write" token scoped to the single kcxlabs-media bucket — not an account-wide
# admin token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kcxlabs-media

# Public hostname serving media bytes (an R2 custom domain, e.g.
# media.kcxlabs.org). Kept separate from the canonical share URL so the link you
# paste is always kcxlabs.org/c/<id>, never a raw bucket URL.
R2_PUBLIC_HOST=

# Cloudflare GraphQL Analytics API token, for real R2 storage metrics.
# A SEPARATE token from the R2 one above: permission "Account Analytics: Read".
# It needs no bucket access.
#
# OPTIONAL. Without it, KCxLabs cannot obtain a provider measurement and the
# storage budget drops to degraded mode: automatic uploads stop at the
# conservative 6 GB local ceiling instead of the normal 8 GB. Uploads still
# work; they are just held to a stricter limit.
CLOUDFLARE_ANALYTICS_TOKEN=

# ─── Neon (Postgres metadata) ───────────────────────────────────────────────
# Pooled connection string from the Neon dashboard. Use a SEPARATE Neon branch
# for development so tests never write to production data.
DATABASE_URL=

# ─── Owner authentication ───────────────────────────────────────────────────
# scrypt hash of the owner password, generated by `npm run auth:hash`.
# This is a hash, not a password — but still treat it as a secret.
OWNER_EMAIL=
OWNER_PASSWORD_HASH=

# 32+ random bytes, hex encoded. Signs owner session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Cost and abuse safeguards ──────────────────────────────────────────────
# Hard ceiling on a single object, in bytes. Default 5 GB.
MAX_UPLOAD_BYTES=5368709120

# Refuse new uploads once this much has been uploaded in a calendar month.
# Default 200 GB. This is the primary guard against a surprise storage bill.
MONTHLY_UPLOAD_QUOTA_BYTES=214748364800

# Set to "true" to refuse all new uploads immediately (kill switch).
UPLOADS_DISABLED=false

# ─── Canonical site origin ──────────────────────────────────────────────────
# Used to build share URLs. No trailing slash.
PUBLIC_SITE_ORIGIN=https://kcxlabs.org
